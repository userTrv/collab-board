{
  "name": "collab-board",
  "version": "1.0.0",
  "description": "Offline-first collaborative kanban + whiteboard built with Angular 22 signals and the Yjs CRDT. No backend: tabs sync over BroadcastChannel, data lives in IndexedDB.",
  "license": "MIT",
  "author": "Kirill Levin",
  "private": true,
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-sw.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "perf": "node scripts/perf.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "lib0": "^0.2.119",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
  }
}
